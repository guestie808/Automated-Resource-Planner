        <mxCell id="TH-26QblozA0zV8-TNaS-800" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;" value="&lt;font&gt;As exporting/ confirming the timetable will have to update a number of databases, having a warning pop-up disclosing that it may be harder to change rooms, equipment, etc. means users have a second chance to think before they definitely confirm the timetable looks good.&lt;/font&gt;" vertex="1">
          <mxGeometry height="92" width="260" x="460" y="1038" as="geometry" />
        </mxCell>
        <mxCell id="TH-26QblozA0zV8-TNaS-801" edge="1" parent="1" style="endArrow=classic;html=1;rounded=0;" value="">
          <mxGeometry height="50" relative="1" width="50" as="geometry">
            <mxPoint x="229.52" y="1110" as="sourcePoint" />
            <mxPoint x="229.76000000000002" y="1150" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="TH-26QblozA0zV8-TNaS-802" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Once confirmed, file explorer will pop up again for the user to select a folder to save the csv to. The databases storing all the data linked to room, equipment, technician, and student timetables will also need to be updated to avoid any double bookings, ensuring the system is always working with up to date data." vertex="1">
          <mxGeometry height="75" width="305" x="77.5" y="1160" as="geometry" />
        </mxCell>
